# Storage Option (accepts 'local' or 's3')
STORAGE_BACKEND=

# S3 Specific Configurations.
ENDPOINT_URL=
BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Local Configuration Specific. Generate an encryption key using aes_key.py
IMAGE_ENCRYPTION_KEY=

# Flask Configurations. Use Python secrets lib to Generate this.
FLASK_SECRET=

# Master key for use in dashboard
MASTER_KEY=

